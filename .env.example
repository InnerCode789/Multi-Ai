# ============================================
# Multi-AI Autonomous Engineering System
# ============================================
# Copy this file to .env and fill in your API keys

# Server
PORT=3000
NODE_ENV=development

# ---- Model Providers ----

# Google Gemini (default: Planner + QA)
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (default: Lead Engineer)
# Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# GitHub Models (default: Critical Reviewer)
# Uses GitHub PAT with models scope
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# Local Ollama (optional, for offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ---- Agent-to-Model Routing ----
# Format: AGENT_<ROLE>_PROVIDER and AGENT_<ROLE>_MODEL
# Providers: gemini, groq, github-models, ollama
AGENT_PLANNER_PROVIDER=gemini
AGENT_PLANNER_MODEL=gemini-3.6-flash
AGENT_ENGINEER_PROVIDER=groq
AGENT_ENGINEER_MODEL=qwen/qwen3.8-27b
AGENT_REVIEWER_PROVIDER=gemini
AGENT_REVIEWER_MODEL=gemini-3.6-flash
AGENT_QA_PROVIDER=gemini
AGENT_QA_MODEL=gemini-3.6-flash

# ---- System Settings ----
MAX_ITERATIONS=10
MAX_TOOL_CALLS_PER_TURN=15
COMMAND_TIMEOUT_MS=30000
WORKSPACE_BASE_DIR=./workspaces
