# ============================================
# Multi-AI Autonomous Engineering System
# ============================================

# Execution Mode: 'local' (Ollama only), 'cloud' (Cloud only), 'hybrid' (Cloud with Ollama fallback)
AI_MODE=local

# Server
PORT=3000
NODE_ENV=development

# ---- Local Ollama (Primary in LOCAL mode) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ---- Cloud Providers (Optional / Used in CLOUD mode) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# ---- Agent-to-Model Routing ----
AGENT_PLANNER_PROVIDER=ollama
AGENT_PLANNER_MODEL=deepseek-r1:7b

AGENT_ENGINEER_PROVIDER=ollama
AGENT_ENGINEER_MODEL=deepseek-r1:7b

AGENT_REVIEWER_PROVIDER=ollama
AGENT_REVIEWER_MODEL=deepseek-r1:7b

AGENT_QA_PROVIDER=ollama
AGENT_QA_MODEL=deepseek-r1:7b

# ---- System Settings ----
MAX_ITERATIONS=10
MAX_TOOL_CALLS_PER_TURN=15
COMMAND_TIMEOUT_MS=30000
WORKSPACE_BASE_DIR=./workspaces
