# ============================================
# ArchitectArena Hybrid - Environment Config
# ============================================
# Copy this file to .env and fill in your keys

# Server
PORT=3000
NODE_ENV=development

# Default execution mode: cloud | local | scraper | hybrid
# cloud  = Groq + GitHub Models + Gemini (free API tiers)
# local  = Ollama (fully offline)
# scraper = Playwright stealth (ChatGPT/DeepSeek web UI)
# hybrid = Tries scraper/local first, auto-failover to cloud
DEFAULT_MODE=cloud

# Failover: if scraper/local fails, auto-switch to cloud
FAILOVER_ENABLED=true

# ---- Mode A: Free Cloud APIs ----

# Agent 1 - Groq (Performance Purist)
# Get free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=deepseek-r1-distill-llama-70b

# Agent 2 - GitHub Models (Security Auditor)
# Uses your GitHub PAT with models scope
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# Agent 3 - Google Gemini (Chief Architect)
# Get free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Mode B: Local Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_AGENT1=deepseek-r1:7b
OLLAMA_MODEL_AGENT2=llama3.2:3b
OLLAMA_MODEL_AGENT3=llama3.2:3b

# ---- Mode C: Playwright Stealth Scraper ----
SCRAPER_TIMEOUT_MS=20000
SCRAPER_USER_DATA_DIR=./.browser_session
